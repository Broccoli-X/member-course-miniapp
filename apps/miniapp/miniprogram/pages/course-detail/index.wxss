.course-detail-page {
  padding: 24rpx;
}
.course-header {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.course-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #222222;
}
.course-desc {
  display: block;
  color: #666666;
  font-size: 26rpx;
  margin-top: 12rpx;
}
.packages {
  margin-top: 8rpx;
}
.package-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}
.package-name {
  font-size: 30rpx;
  color: #222222;
}
.package-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}
.package-price {
  color: #ff6b00;
  font-size: 32rpx;
  font-weight: 600;
}
.package-hours {
  color: #999999;
  font-size: 26rpx;
}
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}
