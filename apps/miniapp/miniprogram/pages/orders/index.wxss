.orders-page {
  padding: 24rpx;
}
.order-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.order-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-no {
  font-size: 26rpx;
  color: #666666;
}
.order-status {
  font-size: 24rpx;
  color: #4C7DFF;
}
.order-time {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}
.order-items {
  margin-top: 20rpx;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 16rpx;
}
.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}
.item-name {
  font-size: 28rpx;
  color: #333333;
}
.item-meta {
  display: flex;
  align-items: center;
}
.item-price {
  font-size: 26rpx;
  color: #333333;
  margin-right: 16rpx;
}
.item-hours {
  font-size: 24rpx;
  color: #999999;
}
.order-total {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 16rpx;
}
.total-label {
  font-size: 24rpx;
  color: #999999;
  margin-right: 12rpx;
}
.total-amount {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 160rpx 0;
  color: #999999;
  font-size: 28rpx;
}
.load-more {
  text-align: center;
  padding: 24rpx 0;
  color: #4C7DFF;
  font-size: 26rpx;
}
