.order-detail-page {
  padding: 24rpx;
}
.order-header {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.order-no {
  font-size: 26rpx;
  color: #666666;
}
.order-status {
  font-size: 24rpx;
  color: #4C7DFF;
}
.order-time {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
  display: block;
}
.items {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.items-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 16rpx;
}
.item-card {
  border-top: 2rpx solid #f0f0f0;
  padding: 20rpx 0;
}
.item-name {
  font-size: 28rpx;
  color: #333333;
  display: block;
  margin-bottom: 12rpx;
}
.item-meta {
  display: flex;
  flex-direction: column;
}
.meta-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
}
.meta-label {
  font-size: 26rpx;
  color: #999999;
}
.meta-value {
  font-size: 26rpx;
  color: #333333;
}
.total-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
}
.total-label {
  font-size: 26rpx;
  color: #999999;
  margin-right: 16rpx;
}
.total-amount {
  font-size: 36rpx;
  color: #333333;
  font-weight: 600;
}
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 160rpx 0;
  color: #999999;
  font-size: 28rpx;
}
