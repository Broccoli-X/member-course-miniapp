<view class="order-detail-page">
  <block wx:if="{{notFound}}">
    <view class="empty-state">
      <text>订单不存在</text>
    </view>
  </block>
  <block wx:elif="{{order}}">
    <view class="order-header">
      <view class="header-row">
        <text class="order-no">订单号 {{order.id}}</text>
        <text class="order-status">{{order.status}}</text>
      </view>
      <text class="order-time" wx:if="{{order.confirmedAt}}">{{order.confirmedAt}}</text>
    </view>

    <view class="items">
      <view class="items-title">订单项目</view>
      <view class="item-card" wx:for="{{order.items}}" wx:key="id">
        <text class="item-name">{{item.productNameSnapshot}}</text>
        <view class="item-meta">
          <view class="meta-row">
            <text class="meta-label">单价</text>
            <text class="meta-value">¥{{item.unitPriceSnapshot}}</text>
          </view>
          <view class="meta-row">
            <text class="meta-label">课时</text>
            <text class="meta-value">{{item.hoursSnapshot}}</text>
          </view>
          <view class="meta-row">
            <text class="meta-label">有效期</text>
            <text class="meta-value">{{item.validDaysSnapshot}}天</text>
          </view>
        </view>
      </view>
    </view>

    <view class="total-bar">
      <text class="total-label">合计</text>
      <text class="total-amount">¥{{order.totalAmount}}</text>
    </view>
  </block>
</view>
