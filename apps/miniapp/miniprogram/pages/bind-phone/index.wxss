.bind-phone-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 48rpx;
}
.bind-phone-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}
.bind-phone-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #333333;
}
.bind-phone-subtitle {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #999999;
}
.bind-phone-button {
  width: 80%;
}
