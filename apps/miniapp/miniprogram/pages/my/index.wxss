.my-page {
  padding: 24rpx;
}
.balances {
  margin-bottom: 24rpx;
}
.balance-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.balance-head {
  margin-bottom: 16rpx;
}
.balance-course {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}
.balance-buckets {
  display: flex;
  justify-content: space-between;
  border-top: 2rpx solid #f0f0f0;
  padding-top: 16rpx;
}
.bucket {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}
.bucket-value {
  font-size: 32rpx;
  color: #333333;
  font-weight: 600;
}
.bucket-label {
  font-size: 22rpx;
  color: #999999;
  margin-top: 6rpx;
}
.entries {
  background-color: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
}
.entry {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 2rpx solid #f0f0f0;
}
.entry:last-child {
  border-bottom: none;
}
.entry-title {
  font-size: 30rpx;
  color: #333333;
}
.entry-arrow {
  font-size: 32rpx;
  color: #cccccc;
}
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}
